{
  "schema_version": 2,
  "dataset": "TopDial",
  "actions": [
    "acknowledge",
    "ask_preference",
    "clarify",
    "explain",
    "recommend",
    "farewell"
  ],
  "encoder_model": "FacebookAI/roberta-large",
  "max_sequence_length": 128,
  "header_tokens": 32,
  "gamma": 0.999,
  "offline_dropout": 0.1,
  "selfplay_dropout": 0.25,
  "offline_epochs": 1,
  "offline_batch_size": 2,
  "offline_lr": 0.000006,
  "offline_weight_decay": 0.001,
  "offline_warmup_steps": 0,
  "offline_critic_weight": 1.0,
  "offline_checkpoint_every": 1,
  "selfplay_epochs": 1,
  "selfplay_cases_per_epoch": 1,
  "selfplay_lr": 0.000001,
  "selfplay_critic_weight": 1.0,
  "mcts_simulations": 3,
  "mcts_cpuct": 1.0,
  "mcts_q0": 0.0,
  "mcts_max_depth": 2,
  "mcts_max_realizations": 1,
  "critic_samples": 2,
  "gradient_clip": 1.0,
  "offline_seed": 42,
  "selfplay_seed": 1,
  "gate_threshold": 1.0
}
