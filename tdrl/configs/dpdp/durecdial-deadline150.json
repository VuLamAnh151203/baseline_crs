{
  "schema_version": 2,
  "dataset": "DuRecDial2.0",
  "actions": [
    "acknowledge",
    "ask_preference",
    "clarify",
    "explain",
    "recommend",
    "farewell"
  ],
  "encoder_model": "FacebookAI/roberta-large",
  "max_sequence_length": 512,
  "header_tokens": 96,
  "gamma": 0.999,
  "offline_dropout": 0.1,
  "selfplay_dropout": 0.25,
  "offline_epochs": 10,
  "offline_batch_size": 8,
  "offline_lr": 0.000006,
  "offline_weight_decay": 0.001,
  "offline_warmup_steps": 400,
  "offline_critic_weight": 1.0,
  "offline_checkpoint_every": 1000,
  "selfplay_epochs": 3,
  "selfplay_cases_per_epoch": 50,
  "selfplay_lr": 0.000001,
  "selfplay_critic_weight": 1.0,
  "mcts_simulations": 10,
  "mcts_cpuct": 1.0,
  "mcts_q0": 0.0,
  "mcts_max_depth": 5,
  "mcts_max_realizations": 1,
  "critic_samples": 10,
  "gradient_clip": 1.0,
  "offline_seed": 42,
  "selfplay_seed": 1,
  "gate_threshold": 0.2
}
