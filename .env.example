# Copy to .env, replace every path for your cluster, then source it before
# running scripts/submit_baseline.sh. Do not commit .env.
export BASELINE_STORAGE_ROOT=/absolute/scratch/path/baseline_crs
export BASELINE_PYTHON=/absolute/path/baseline_crs/tdrl/runtime/.venv/bin/python

# Slurm site settings.
export SLURM_PARTITION=main
export SLURM_ACCOUNT=normal
export SLURM_GRES=gpu:nvidia_h100_80gb_hbm3:2

# Required only by EnPL-domain3. The archive hash is pinned in
# tdrl/configs/enpl-reference.lock.json.
export ENPL_CONVPLAN_ZIP=/absolute/path/ConvPlan.zip

# Required only by SCOPE-CRS-lite. This directory contains the imported,
# hash-verified transition ensemble and the Llama Guard snapshot.
export SCOPE_ASSET_ROOT=/absolute/scratch/path/scope/assets

# Optional explicit run directory for resume. Never point this at a different
# method's run.
# export BASELINE_RUN_ROOT=/absolute/scratch/path/existing-run
# export BASELINE_RESUME=1
